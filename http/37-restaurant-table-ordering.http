### 9. Cria a mesa do QR: a resposta traz o orderingToken
POST {{host}}/api/restaurant/dining-tables
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "label": "QR {{suffix}}",
  "seats": 4,
  "area": "Salao"
}

> {%
    client.test("mesa criada com codigo do QR", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(typeof response.body.orderingToken === "string" && response.body.orderingToken.length === 36,
            "orderingToken " + response.body.orderingToken);
    });
    client.global.set("tableId", response.body.id);
    client.global.set("orderingToken", response.body.orderingToken);
%}


