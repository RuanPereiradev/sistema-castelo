### 41. Recepcao nao ve a fila de pedidos do QR -> 403 ACCESS_DENIED
GET {{host}}/api/restaurant/table-order-requests
Authorization: Bearer {{frontDeskToken}}

> {%
    client.test("fila do QR so para salao: 403 ACCESS_DENIED", function() {
        client.assert(response.status === 403, "esperado 403, recebido " + response.status);
        client.assert(response.body.code === "ACCESS_DENIED", "code " + response.body.code);
    });
%}


### 42. Garcom inicia o fechamento da comanda da mesa (pre-conta)
POST {{host}}/api/restaurant/tabs/{{tabId}}/closing
Authorization: Bearer {{waiterToken}}

> {%
    client.test("comanda em CLOSING", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.status === "CLOSING", "status " + response.body.status);
    });
%}


### 43. O QR avisa que a conta esta sendo fechada
GET {{host}}/public/tables/{{orderingToken}}

> {%
    client.test("acceptsOrders falso com a comanda em CLOSING", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.acceptsOrders === false, "nao deveria aceitar pedido");
    });
%}


### 44. Pedir com a comanda em CLOSING -> 409 TAB_CLOSING_REFUSES_ORDER_REQUEST
POST {{host}}/public/tables/{{orderingToken}}/order-requests
Content-Type: application/json

{
  "customerName": "Ana",
  "customerDeviceId": "device-{{suffix}}-ana",
  "lines": [{"menuItemId": "{{pizzaId}}", "quantity": 1}]
}

> {%
    client.test("CLOSING: 409 TAB_CLOSING_REFUSES_ORDER_REQUEST", function() {
        client.assert(response.status === 409, "esperado 409, recebido " + response.status);
        client.assert(response.body.code === "TAB_CLOSING_REFUSES_ORDER_REQUEST", "code " + response.body.code);
    });
%}


### 45. Admin gera um QR novo para a mesa
POST {{host}}/api/restaurant/dining-tables/{{tableId}}/ordering-token
Authorization: Bearer {{adminToken}}

> {%
    client.test("codigo novo, diferente do impresso", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.orderingToken !== client.global.get("orderingToken"), "deveria trocar");
    });
    client.global.set("newOrderingToken", response.body.orderingToken);
%}


### 46. QR antigo -> 404 DINING_TABLE_NOT_FOUND
GET {{host}}/public/tables/{{orderingToken}}

> {%
    client.test("QR regenerado: 404 DINING_TABLE_NOT_FOUND", function() {
        client.assert(response.status === 404, "esperado 404, recebido " + response.status);
        client.assert(response.body.code === "DINING_TABLE_NOT_FOUND", "code " + response.body.code);
    });
%}


### 47. QR novo responde
GET {{host}}/public/tables/{{newOrderingToken}}

