    });
    client.global.set("otherOrderingToken", response.body.orderingToken);
%}


### ------------------------------------------------------------------
### Caminho feliz
### ------------------------------------------------------------------


### 11. Cliente escaneia o QR: mesa aceita pedido, nada aguardando
GET {{host}}/public/tables/{{orderingToken}}

> {%
    client.test("mesa lida sem login", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.diningTableLabel === "QR " + client.global.get("suffix"), "label " + response.body.diningTableLabel);
        client.assert(response.body.acceptsOrders === true, "deveria aceitar pedido");
        client.assert(response.body.pendingRequestId === null, "nada aguardando");
        client.assert(response.body.id === undefined, "nao expoe o id da mesa");
    });
%}


### 12. Cliente pede 2 pizzas com 1 borda e um suco
POST {{host}}/public/tables/{{orderingToken}}/order-requests
Content-Type: application/json

{
  "customerName": "Ana",
  "customerDeviceId": "device-{{suffix}}-ana",
  "lines": [
    {
      "menuItemId": "{{pizzaId}}",
      "quantity": 2,
      "modifiers": [{"modifierId": "{{crustId}}", "quantity": 1}],
      "specialInstructions": "sem cebola"
    },
    {
      "menuItemId": "{{juiceId}}",
      "quantity": 1
    }
  ]
}

> {%
    client.test("pedido enviado: 201 PENDING com janela de 30 min", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.status === "PENDING", "status " + response.body.status);
        const window = new Date(response.body.expiresAt) - new Date(response.body.requestedAt);
        client.assert(window === 30 * 60 * 1000, "janela " + window);
    });
    client.global.set("requestId", response.body.id);
%}


### 13. O QR mostra o pedido aguardando
GET {{host}}/public/tables/{{orderingToken}}

> {%
    client.test("pendingRequestId e o pedido enviado", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.pendingRequestId === client.global.get("requestId"), "pending " + response.body.pendingRequestId);
    });
%}


### 14. Celular le o estado do pedido
GET {{host}}/public/tables/{{orderingToken}}/order-requests/{{requestId}}

> {%
    client.test("pedido aguardando, sem dados de quem atende", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.status === "PENDING", "status " + response.body.status);
        client.assert(response.body.resolvedBy === undefined, "nao expoe usuario");
    });
%}


### 15. Garcom ve a fila: nomes de item, adicional e mesa
GET {{host}}/api/restaurant/table-order-requests
Authorization: Bearer {{waiterToken}}

> {%
    client.test("pedido na fila com os nomes resolvidos", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        const request = response.body.find(r => r.id === client.global.get("requestId"));
        client.assert(request !== undefined, "pedido nao esta na fila");
        client.assert(request.diningTableLabel === "QR " + client.global.get("suffix"), "mesa " + request.diningTableLabel);
        client.assert(request.lines.length === 2, "linhas " + request.lines.length);
        client.assert(request.lines[0].menuItemName === "Pizza QR " + client.global.get("suffix"), "item " + request.lines[0].menuItemName);
        client.assert(request.lines[0].modifiers[0].modifierName === "Borda QR " + client.global.get("suffix"), "adicional");
        client.assert(request.lines[0].specialInstructions === "sem cebola", "observacao");
        client.assert(request.customerName === "Ana", "nome " + request.customerName);
    });
%}


### 16. Garcom confirma: a comanda da mesa abre e recebe os itens
POST {{host}}/api/restaurant/table-order-requests/{{requestId}}/confirm
Authorization: Bearer {{waiterToken}}

> {%
    client.test("confirmado com a comanda aberta", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.request.status === "CONFIRMED", "status " + response.body.request.status);
        client.assert(typeof response.body.tabId === "string", "tabId " + response.body.tabId);
    });
    client.global.set("tabId", response.body.tabId);
%}


### 17. A comanda tem as duas linhas: (40,00 + 8,50) x 2 + 9,00 = 106,00
GET {{host}}/api/restaurant/tabs/{{tabId}}
Authorization: Bearer {{waiterToken}}

> {%
    client.test("itens na comanda, com subtotal 106,00", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.status === "OPEN", "status " + response.body.status);
        client.assert(response.body.items.length === 2, "itens " + response.body.items.length);
        client.assert(response.body.subtotal === "106.00", "subtotal " + response.body.subtotal);
        client.assert(response.body.items[0].customerName === "Ana", "item com o nome de quem pediu");
    });
%}


### 18. A pizza chegou na fila do setor PIZZA
GET {{host}}/api/kitchen/queue?station=PIZZA
Authorization: Bearer {{adminToken}}

> {%
    client.test("pizza da mesa QR na fila da cozinha", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        const ticket = response.body.items.find(t => t.tabId === client.global.get("tabId"));
        client.assert(ticket !== undefined, "pizza nao chegou na fila");
        client.assert(ticket.quantity === 2, "quantidade " + ticket.quantity);
    });
%}


