### 27. Abre comanda no cartao sorteado
POST {{host}}/api/restaurant/tabs
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "origin": "SELF_SERVICE",
  "cardNumber": {{cardNumber}}
}

> {%
    client.test("comanda do cartao aberta", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.cardNumber === Number(client.global.get("cardNumber")), "cartao gravado");
        client.assert(response.body.diningTableId === null, "comanda de cartao sem mesa");
    });
    client.global.set("cardTabId", response.body.id);
%}


### 28. Pesa um prato de 437 g no buffet: 437 g x 59,90 = 26,18
POST {{host}}/api/restaurant/tabs/{{cardTabId}}/items
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "menuItemId": "{{buffetId}}",
  "weightGrams": 437
}

> {%
    client.test("prato por peso lancado", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        const item = response.body.items[0];
        client.assert(item.weightGrams === 437, "peso em gramas");
        client.assert(item.pricePerKilo === "59.90", "preco por quilo congelado");
        client.assert(item.unitPrice === null, "sem preco unitario");
        client.assert(item.lineTotal === "26.18", "lineTotal deveria ser 26.18, recebido " + item.lineTotal);
        client.assert(item.status === "DELIVERED", "prato por peso nasce DELIVERED");
        client.assert(item.serviceChargeable === false, "self-service nao cobra taxa");
    });
    client.global.set("plateItemId", response.body.items[0].id);
%}


### 29. Cancela o prato, com motivo
POST {{host}}/api/restaurant/tabs/{{cardTabId}}/items/{{plateItemId}}/cancel
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "reason": "  pesado no cartao errado  "
}

> {%
    client.test("prato cancelado, fica na comanda", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        const item = response.body.items[0];
        client.assert(item.status === "CANCELLED", "item CANCELLED");
        client.assert(item.cancellationReason === "pesado no cartao errado", "motivo aparado");
        client.assert(item.cancelledBy !== null && item.cancelledAt !== null, "autor e horario gravados");
        client.assert(response.body.subtotal === "0.00", "subtotal ignora cancelado");
    });
%}


### 30. Lista as comandas ativas da mesa
GET {{host}}/api/restaurant/tabs?diningTableId={{diningTableId}}
Authorization: Bearer {{waiterToken}}

> {%
    client.test("lista pela mesa", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.length === 1, "uma comanda ativa na mesa");
        client.assert(response.body[0].id === client.global.get("tableTabId"), "a comanda da mesa");
        client.assert(response.body[0].subtotal === "186.00", "subtotal na lista");
        client.assert(response.body[0].activeItemCount === 1, "um item ativo");
    });
%}


