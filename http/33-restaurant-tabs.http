### 23. Garcom abre comanda na mesa
POST {{host}}/api/restaurant/tabs
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "origin": "TABLE_SERVICE",
  "diningTableId": "{{diningTableId}}"
}

> {%
    client.test("comanda da mesa aberta", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.status === "OPEN", "comanda nasce OPEN");
        client.assert(response.body.diningTableLabel === "Mesa " + client.global.get("suffix"), "label da mesa");
        client.assert(response.body.cardNumber === null, "comanda de mesa sem cartao");
        client.assert(response.body.subtotal === "0.00", "subtotal inicial 0.00");
        client.assert(response.body.items.length === 0, "comanda nasce sem itens");
        client.assert(response.body.publicToken === undefined, "publicToken nao sai na API");
    });
    client.global.set("tableTabId", response.body.id);
%}


### 24. Lanca 3 pizzas G com 2 bordas, ponto da carne e observacao: (45,00 + 2 x 8,50 + 0,00) x 3 = 186,00
POST {{host}}/api/restaurant/tabs/{{tableTabId}}/items
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "menuItemId": "{{pizzaId}}",
  "variantId": "{{largeVariantId}}",
  "quantity": 3,
  "modifiers": [
    { "modifierId": "{{stuffedCrustId}}", "quantity": 2 },
    { "modifierId": "{{doneLevelId}}", "quantity": 1 }
  ],
  "specialInstructions": "  sem cebola  "
}

> {%
    client.test("pizza lancada com preco congelado", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        const item = response.body.items[0];
        client.assert(item.variantName === "G", "variacao G");
        client.assert(item.unitPrice === "45.00", "preco da variacao substitui o do item");
        client.assert(item.lineTotal === "186.00", "lineTotal deveria ser 186.00, recebido " + item.lineTotal);
        client.assert(item.modifiers.length === 2, "dois adicionais");
        client.assert(item.serviceChargeable === true, "mesa cobra taxa");
        client.assert(item.specialInstructions === "sem cebola", "observacao aparada");
        client.assert(item.status === "PENDING", "item nasce PENDING");
        client.assert(item.prepStation === "PIZZA", "setor congelado");
        client.assert(response.body.subtotal === "186.00", "subtotal 186.00");
    });
    client.global.set("pizzaItemId", response.body.items[0].id);
%}


