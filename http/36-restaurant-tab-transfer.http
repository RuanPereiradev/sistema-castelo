### 37. Mesa para cartao: o item perde a taxa, porque o self-service nao cobra (T3)
POST {{host}}/api/restaurant/tabs/{{tabCId}}/transfer
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "toTabId": "{{cardTabId}}",
  "itemIds": ["{{buffetItemId}}"]
}

> {%
    client.test("prato por peso vai para o cartao, sem taxa no destino", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.destination.subtotal === "26.18", "subtotal cartao " + response.body.destination.subtotal);
        client.assert(response.body.destination.serviceCharge === "0.00", "o cartao nao cobra taxa");
        client.assert(response.body.destination.total === "26.18", "total cartao " + response.body.destination.total);
        const moved = response.body.destination.items.find(function(i) { return i.id === client.global.get("buffetItemId"); });
        client.assert(moved.status === "DELIVERED", "o prato por peso continua entregue");
    });
%}


### ------------------------------------------------------------------
### Rastro: a tabela guarda todo salto, a coluna guarda o ultimo
### ------------------------------------------------------------------


### 38. A pizza fez dois saltos; a coluna mostra so o ultimo (T11)
GET {{host}}/api/restaurant/tabs/{{tabCId}}
Authorization: Bearer {{waiterToken}}

> {%
    client.test("transferredFromTabId e o ultimo salto", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        const pizza = response.body.items.find(function(i) { return i.id === client.global.get("pizzaItemId"); });
        client.assert(pizza.transferredFromTabId === client.global.get("tabBId"), "A -> B -> C: o ultimo e B");
        const couvert = response.body.items.find(function(i) { return i.id === client.global.get("couvertItemId"); });
        client.assert(couvert.transferredFromTabId === client.global.get("tabBId"), "o couvert tambem veio de B");
    });
%}


