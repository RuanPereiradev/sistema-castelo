### 29. Junta A em B: B fica, A vira MERGED, guestCount soma (T8, T14)
POST {{host}}/api/restaurant/tabs/{{tabBId}}/merge
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "mergedTabId": "{{tabAId}}"
}

> {%
    client.test("A absorvida por B", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.id === client.global.get("tabBId"), "a comanda da rota e a que fica");
        client.assert(response.body.status === "OPEN", "B continua aberta");
        client.assert(response.body.guestCount === 5, "2 + 3 = 5, recebido " + response.body.guestCount);
        client.assert(response.body.subtotal === "90.18", "subtotal B " + response.body.subtotal);
        const couvert = response.body.items.find(function(i) { return i.id === client.global.get("couvertItemId"); });
        client.assert(couvert, "o couvert deveria ter vindo");
        client.assert(couvert.transferredFromTabId === client.global.get("tabAId"), "origem do couvert");
    });
%}


