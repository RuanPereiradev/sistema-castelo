### 25. Transfere o refrigerante de A para B: chega com a taxa dispensada (T7)
POST {{host}}/api/restaurant/tabs/{{tabAId}}/transfer
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "toTabId": "{{tabBId}}",
  "itemIds": ["{{sodaItemId}}"]
}

> {%
    client.test("a dispensa da taxa viaja com o item", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        const moved = response.body.destination.items.find(function(i) { return i.id === client.global.get("sodaItemId"); });
        client.assert(moved.serviceChargeWaived === true, "deveria chegar dispensado");
        client.assert(moved.serviceChargeable === true, "o retrato do lancamento nao muda");
        client.assert(response.body.source.subtotal === "12.00", "subtotal A " + response.body.source.subtotal);
        client.assert(response.body.destination.subtotal === "78.18", "subtotal B " + response.body.destination.subtotal);
    });
%}


