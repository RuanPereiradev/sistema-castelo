### 21. Transfere a pizza de A para B: 40,00 saem de A e entram em B
POST {{host}}/api/restaurant/tabs/{{tabAId}}/transfer
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "toTabId": "{{tabBId}}",
  "itemIds": ["{{pizzaItemId}}"]
}

> {%
    client.test("pizza transferida, dinheiro conservado", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.movedItems === 1, "um item movido");
        client.assert(response.body.source.subtotal === "24.00", "subtotal A " + response.body.source.subtotal);
        client.assert(response.body.destination.subtotal === "66.18", "subtotal B " + response.body.destination.subtotal);
        const moved = response.body.destination.items.find(function(i) { return i.id === client.global.get("pizzaItemId"); });
        client.assert(moved, "a pizza deveria estar na B");
        client.assert(moved.transferredFromTabId === client.global.get("tabAId"), "origem gravada");
        client.assert(moved.transferredAt !== null, "instante gravado");
        client.assert(moved.transferredBy !== null, "autor gravado");
        client.assert(moved.splitGroup === 1, "grupo volta ao 1");
        client.assert(moved.lineTotal === "40.00", "lineTotal intacto");
        client.assert(moved.serviceChargeable === true, "retrato da taxa intacto");
        const gone = response.body.source.items.some(function(i) { return i.id === client.global.get("pizzaItemId"); });
        client.assert(!gone, "a pizza nao deveria estar mais na A");
    });
%}


### 22. A fila da pizzaria mostra a pizza sob a mesa B
GET {{host}}/api/kitchen/queue?station=PIZZA
Authorization: Bearer {{kitchenToken}}

> {%
    client.test("pizza na fila, com a mesa nova", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        const ticket = response.body.items.find(function(t) { return t.itemId === client.global.get("pizzaItemId"); });
        client.assert(ticket, "pizza na fila PIZZA");
        client.assert(ticket.tabId === client.global.get("tabBId"), "ticket na comanda B");
        client.assert(ticket.diningTableLabel === "Transf B {{suffix}}", "rotulo " + ticket.diningTableLabel);
    });
%}


