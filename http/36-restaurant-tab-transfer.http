### 33. A recepcao troca a comanda B para a mesa C (T5, T12)
POST {{host}}/api/restaurant/tabs/{{tabBId}}/move
Authorization: Bearer {{frontDeskToken}}
Content-Type: application/json

{
  "diningTableId": "{{tableCId}}"
}

> {%
    client.test("comanda trocada de mesa pela recepcao, com id novo", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.id !== client.global.get("tabBId"), "a comanda deveria ter id novo");
        client.assert(response.body.status === "OPEN", "status " + response.body.status);
        client.assert(response.body.diningTableId === client.global.get("tableCId"), "mesa C");
        client.assert(response.body.subtotal === "90.18", "subtotal " + response.body.subtotal);
        client.assert(response.body.guestCount === 5, "guestCount " + response.body.guestCount);
        const pizza = response.body.items.find(function(i) { return i.id === client.global.get("pizzaItemId"); });
        client.assert(pizza.status === "IN_PREPARATION", "a pizza segue em preparo");
        client.assert(pizza.transferredFromTabId === client.global.get("tabBId"), "ultimo salto: B");
    });
    client.global.set("tabCId", response.body.id);
%}


