POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "{{waiterUsername}}",
  "password": "{{password}}"
}

> {%
    client.test("login do garcom retorna 200", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
    });
    client.global.set("waiterToken", response.body.accessToken);
%}


### 2. Login da recepcao, para o 403
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "{{frontDeskUsername}}",
  "password": "{{password}}"
}

> {%
    client.test("login da recepcao retorna 200", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
    });
    client.global.set("frontDeskToken", response.body.accessToken);
%}


### ------------------------------------------------------------------
### As duas datas: o aluguel de outubro pago no dia 5
### ------------------------------------------------------------------


### 3. Aluguel como conta a pagar: competencia em outubro, vencimento dia 10
POST {{host}}/api/finance/expenses
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "category": "RENT",
  "description": "Aluguel de outubro {{suffix}}",
  "amount": "3000.00",
  "accrualDate": "2026-10-01",
  "dueDate": "2026-10-10",
  "supplierName": "Imobiliaria Central"
}

> {%
    client.test("conta a pagar registrada", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.paid === false, "nao deveria estar paga");
        client.assert(response.body.payable === true, "deveria estar a pagar");
        client.assert(response.body.paidAt === null, "sem data de pagamento");
        client.assert(response.body.accrualDate === "2026-10-01", "competencia " + response.body.accrualDate);
        client.assert(response.body.amount === "3000.00", "valor " + response.body.amount);
    });
    client.global.set("rentId", response.body.id);
%}


### 4. Aparece nas contas a pagar
GET {{host}}/api/finance/payables
Authorization: Bearer {{adminToken}}

> {%
    client.test("aluguel na lista de contas a pagar", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        const found = response.body.expenses.some(function(e) { return e.id === client.global.get("rentId"); });
        client.assert(found, "o aluguel deveria estar a pagar");
    });
%}


### 5. Quita o aluguel em PIX: a competencia nao muda
POST {{host}}/api/finance/expenses/{{rentId}}/payment
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "method": "PIX"
}

> {%
    client.test("aluguel pago, competencia intacta", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.paid === true, "deveria estar paga");
        client.assert(response.body.payable === false, "nao esta mais a pagar");
        client.assert(response.body.paidAt !== null, "data de pagamento gravada");
        client.assert(response.body.method === "PIX", "forma " + response.body.method);
        client.assert(response.body.accrualDate === "2026-10-01", "a competencia nao muda ao pagar");
        client.assert(response.body.amount === "3000.00", "o valor nao muda ao pagar");
    });
%}


### 6. Saiu das contas a pagar
GET {{host}}/api/finance/payables
Authorization: Bearer {{adminToken}}

> {%
    client.test("aluguel fora das contas a pagar", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        const found = response.body.expenses.some(function(e) { return e.id === client.global.get("rentId"); });
        client.assert(!found, "nao deveria estar mais a pagar");
    });
%}


### 7. Pagar de novo -> 409 EXPENSE_ALREADY_PAID
POST {{host}}/api/finance/expenses/{{rentId}}/payment
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "method": "DEBIT_CARD"
}

> {%
    client.test("segundo pagamento recusado", function() {
        client.assert(response.status === 409, "esperado 409, recebido " + response.status);
        client.assert(response.body.code === "EXPENSE_ALREADY_PAID", "code " + response.body.code);
    });
%}


### 8. Cancelar despesa paga -> 409 EXPENSE_ALREADY_PAID
POST {{host}}/api/finance/expenses/{{rentId}}/cancel
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reason": "mudei de ideia"
}

> {%
    client.test("despesa paga nao cancela: estorne o pagamento primeiro", function() {
        client.assert(response.status === 409, "esperado 409, recebido " + response.status);
        client.assert(response.body.code === "EXPENSE_ALREADY_PAID", "code " + response.body.code);
    });
%}


### ------------------------------------------------------------------
### Dinheiro vivo sai da gaveta (D4)
### ------------------------------------------------------------------


### 9. Procura turno de caixa aberto (200 ou 404)
GET {{host}}/api/billing/cash-sessions/current
Authorization: Bearer {{adminToken}}

> {%
    client.global.set("staleSessionId", response.status === 200 ? response.body.id : "");
%}


### 10. Fecha o turno esquecido, se houver
POST {{host}}/api/billing/cash-sessions/{{staleSessionId}}/close
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "countedAmount": "0.00"
}

> {%
    client.test("turno esquecido fechado ou inexistente", function() {
        client.assert(response.status === 200 || response.status === 404 || response.status === 400,
            "esperado 200, 404 ou 400, recebido " + response.status);
    });
%}


### 11. Despesa em dinheiro sem turno aberto -> 409 CASH_EXPENSE_REQUIRES_DRAWER_SESSION
POST {{host}}/api/finance/expenses
Authorization: Bearer {{adminToken}}
Idempotency-Key: {{keyPrefix}}-no-drawer
Content-Type: application/json

{
  "category": "SUPPLIER",
  "description": "Peixe do dia {{suffix}}",
  "amount": "200.00",
  "method": "CASH"
}

> {%
    client.test("dinheiro precisa de gaveta aberta", function() {
        client.assert(response.status === 409, "esperado 409, recebido " + response.status);
        client.assert(response.body.code === "CASH_EXPENSE_REQUIRES_DRAWER_SESSION", "code " + response.body.code);
    });
%}


### 12. Abre o turno com fundo de 500,00
POST {{host}}/api/billing/cash-sessions
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "openingFloat": "500.00"
}

> {%
    client.test("turno aberto", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.expectedAmount === "500.00", "esperado " + response.body.expectedAmount);
    });
    client.global.set("sessionId", response.body.id);
%}


### 13. Paga o peixe em dinheiro: 200,00 saem da gaveta
POST {{host}}/api/finance/expenses
Authorization: Bearer {{adminToken}}
Idempotency-Key: {{keyPrefix}}-fish
Content-Type: application/json

{
  "category": "SUPPLIER",
  "description": "Peixe do dia {{suffix}}",
  "amount": "200.00",
  "supplierName": "Peixaria do Porto",
  "method": "CASH"
}

> {%
    client.test("despesa em dinheiro paga, amarrada ao turno", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.paid === true, "deveria estar paga");
        client.assert(response.body.method === "CASH", "forma " + response.body.method);
        client.assert(response.body.cashDrawerSessionId === client.global.get("sessionId"),
            "deveria apontar o turno aberto");
    });
%}


### 14. O esperado do caixa caiu: 500,00 - 200,00 = 300,00
GET {{host}}/api/billing/cash-sessions/{{sessionId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("a gaveta sabe que o dinheiro saiu", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.expectedAmount === "300.00",
            "esperado 300.00, recebido " + response.body.expectedAmount);
    });
%}


### 15. Fechamento cego fecha certo: contou 300,00, sem quebra
POST {{host}}/api/billing/cash-sessions/{{sessionId}}/close
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "countedAmount": "300.00"
}

> {%
    client.test("sem quebra: a despesa entrou na conta da gaveta", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.difference === "0.00", "diferenca " + response.body.difference);
    });
%}


