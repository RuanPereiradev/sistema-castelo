### ------------------------------------------------------------------
### Cancelamento
### ------------------------------------------------------------------


### 20. Cancela a folha com motivo
POST {{host}}/api/finance/expenses/{{payrollId}}/cancel
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reason": "lancada em duplicidade"
}

> {%
    client.test("folha cancelada, com motivo e autor", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.cancelledAt !== null, "cancelledAt");
        client.assert(response.body.cancelledBy !== null, "cancelledBy");
        client.assert(response.body.cancellationReason === "lancada em duplicidade", "motivo");
        client.assert(response.body.payable === false, "nao esta mais a pagar");
    });
%}


### 21. Cancelar sem motivo -> 422 INVALID_EXPENSE_CANCELLATION
POST {{host}}/api/finance/expenses
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "category": "OTHER",
  "description": "Para cancelar sem motivo {{suffix}}",
  "amount": "10.00"
}

> {%
    client.test("despesa criada", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
    });
    client.global.set("toCancelId", response.body.id);
%}


### 22. Agora sem motivo
POST {{host}}/api/finance/expenses/{{toCancelId}}/cancel
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reason": "   "
}

> {%
    client.test("cancelamento precisa de motivo", function() {
        client.assert(response.status === 422, "esperado 422, recebido " + response.status);
        client.assert(response.body.code === "INVALID_EXPENSE_CANCELLATION", "code " + response.body.code);
    });
%}


### ------------------------------------------------------------------
### Os dois regimes lado a lado
### ------------------------------------------------------------------


### 23. Por competencia: outubro inclui o aluguel e a folha cancelada ficou fora
GET {{host}}/api/finance/expenses?from=2026-10-01&to=2026-10-31&by=ACCRUAL
Authorization: Bearer {{adminToken}}

> {%
    client.test("despesas de outubro por competencia", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        const ids = response.body.expenses.map(function(e) { return e.id; });
        client.assert(ids.indexOf(client.global.get("rentId")) >= 0, "o aluguel de outubro deveria estar");
        client.assert(ids.indexOf(client.global.get("payrollId")) < 0, "a folha cancelada nao conta");
        client.assert(response.body.total !== undefined, "a lista traz o total somado");
    });
%}


### 24. Por pagamento: o mesmo aluguel aparece no dia em que o dinheiro saiu
GET {{host}}/api/finance/expenses?from=2026-01-01&to=2030-12-31&by=PAYMENT
Authorization: Bearer {{adminToken}}

> {%
    client.test("despesas por data de pagamento", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        const ids = response.body.expenses.map(function(e) { return e.id; });
        client.assert(ids.indexOf(client.global.get("rentId")) >= 0, "o aluguel pago deveria estar");
        client.assert(ids.indexOf(client.global.get("toCancelId")) < 0, "despesa nao paga nao entra no caixa");
    });
%}


