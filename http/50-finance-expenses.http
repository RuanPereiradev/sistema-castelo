### 18. Salario como conta a pagar, nomeando o funcionario
POST {{host}}/api/finance/expenses
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "category": "PAYROLL",
  "description": "Salario de outubro {{suffix}}",
  "amount": "2200.00",
  "accrualDate": "2026-10-01",
  "dueDate": "2026-11-05",
  "employeeId": "{{employeeId}}"
}

> {%
    client.test("folha registrada com o funcionario", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.employeeId === client.global.get("employeeId"), "funcionario nomeado");
    });
    client.global.set("payrollId", response.body.id);
%}


### 19. Funcionario em categoria que nao e folha -> 422 INVALID_EXPENSE_EMPLOYEE
POST {{host}}/api/finance/expenses
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "category": "RENT",
  "description": "Aluguel errado {{suffix}}",
