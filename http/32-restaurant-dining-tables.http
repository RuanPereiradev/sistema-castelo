### 23. Login do garcom, para os cenarios 24 a 27
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "{{waiterUsername}}",
  "password": "{{password}}"
}

> {%
    client.global.set("waiterToken", response.body.accessToken);
%}


### 24. Garcom le a lista de mesas ativas
GET {{host}}/api/restaurant/dining-tables
Authorization: Bearer {{waiterToken}}

> {%
    const suffix = client.global.get("suffix");
    const labels = response.body.map(function(table) { return table.label; })
        .filter(function(label) { return label.endsWith(" " + suffix); });
    client.test("garcom le a lista na mesma ordem", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(JSON.stringify(labels) === JSON.stringify(["Mesa 2 " + suffix, "Mesa 10 " + suffix, "v1 " + suffix, "Balcao " + suffix]), "ordem recebida: " + JSON.stringify(labels));
    });
%}


### 25. Garcom le uma mesa
GET {{host}}/api/restaurant/dining-tables/{{table2Id}}
Authorization: Bearer {{waiterToken}}

> {%
    client.test("garcom le uma mesa: 200", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
    });
%}


### 26. Garcom tentando cadastrar mesa -> 403 ACCESS_DENIED
POST {{host}}/api/restaurant/dining-tables
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "label": "Garcom {{suffix}}"
}

> {%
    client.test("garcom nao cadastra mesa: 403 ACCESS_DENIED", function() {
        client.assert(response.status === 403, "esperado 403, recebido " + response.status);
        client.assert(response.body.code === "ACCESS_DENIED", "code deveria ser ACCESS_DENIED");
    });
%}


### 27. Garcom pedindo as inativas -> 403 ACCESS_DENIED
GET {{host}}/api/restaurant/dining-tables?includeInactive=true
Authorization: Bearer {{waiterToken}}

> {%
    client.test("garcom nao ve as inativas: 403 ACCESS_DENIED", function() {
        client.assert(response.status === 403, "esperado 403, recebido " + response.status);
        client.assert(response.body.code === "ACCESS_DENIED", "code deveria ser ACCESS_DENIED");
    });
%}
