    client.test("refrigerante pronto", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.status === "READY" && response.body.preparationStartedAt === null, "READY sem preparationStartedAt");
    });
%}


