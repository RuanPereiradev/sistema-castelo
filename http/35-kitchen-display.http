### 12. Lanca um prato por peso no cartao (nasce DELIVERED, nunca vai para a fila)
POST {{host}}/api/restaurant/tabs/{{cardTabId}}/items
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "menuItemId": "{{buffetId}}",
  "weightGrams": 300
}

> {%
    client.test("prato lancado", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.items[0].status === "DELIVERED", "prato DELIVERED");
    });
    client.global.set("plateItemId", response.body.items[0].id);
%}


### ------------------------------------------------------------------
### Caminho feliz
### ------------------------------------------------------------------


### 13. Fila da pizzaria: tem a pizza, nao tem o refrigerante, traz os limites
GET {{host}}/api/kitchen/queue?station=PIZZA
Authorization: Bearer {{kitchenToken}}

> {%
    function hasItem(queue, id) { return queue.items.some(function(ticket) { return ticket.itemId === id; }); }
    client.test("fila PIZZA", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(hasItem(response.body, client.global.get("pizzaItemId")), "pizza na fila");
        client.assert(!hasItem(response.body, client.global.get("sodaItemId")), "refrigerante fora da fila");
        client.assert(response.body.warningAfterMinutes === 20 && response.body.lateAfterMinutes === 30, "limites 20/30");
        client.assert(response.body.serverTime, "serverTime presente");
    });
%}


### 14. Fila do bar: tem o refrigerante
GET {{host}}/api/kitchen/queue?station=BAR
Authorization: Bearer {{kitchenToken}}

> {%
    function hasItem(queue, id) { return queue.items.some(function(ticket) { return ticket.itemId === id; }); }
    client.test("fila BAR", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(hasItem(response.body, client.global.get("sodaItemId")), "refrigerante na fila");
    });
%}


### 15. Fila da cozinha: o prato por peso nao aparece
GET {{host}}/api/kitchen/queue?station=KITCHEN
Authorization: Bearer {{kitchenToken}}

> {%
    function hasItem(queue, id) { return queue.items.some(function(ticket) { return ticket.itemId === id; }); }
    client.test("fila KITCHEN", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(!hasItem(response.body, client.global.get("plateItemId")), "prato por peso fora da fila");
    });
%}


### 16. Negativo: desfazer item PENDING (a pizza ainda nao comecou)
POST {{host}}/api/kitchen/items/{{pizzaItemId}}/undo
Authorization: Bearer {{kitchenToken}}

> {%
    client.test("pendente nao desfaz", function() {
        client.assert(response.status === 409, "esperado 409, recebido " + response.status);
        client.assert(response.body.code === "INVALID_TAB_ITEM_TRANSITION", "code INVALID_TAB_ITEM_TRANSITION, recebido " + response.body.code);
    });
%}


### 17. Cozinha inicia o preparo da pizza
POST {{host}}/api/kitchen/items/{{pizzaItemId}}/start
Authorization: Bearer {{kitchenToken}}

> {%
    client.test("pizza em preparo", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.status === "IN_PREPARATION", "IN_PREPARATION");
        client.assert(response.body.preparationStartedAt, "preparationStartedAt gravado");
        client.assert(response.body.specialInstructions === "sem cebola", "observacao no ticket");
    });
%}


### 18. Cozinha marca a pizza pronta
POST {{host}}/api/kitchen/items/{{pizzaItemId}}/ready
Authorization: Bearer {{kitchenToken}}

> {%
    client.test("pizza pronta", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.status === "READY" && response.body.readyAt, "READY com readyAt");
    });
%}


### 19. Cozinha desfaz o pronto (toque errado)
POST {{host}}/api/kitchen/items/{{pizzaItemId}}/undo
Authorization: Bearer {{kitchenToken}}

> {%
    client.test("pronto desfeito", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.status === "IN_PREPARATION" && response.body.readyAt === null, "volta a IN_PREPARATION sem readyAt");
    });
%}


### 20. Cozinha marca a pizza pronta de novo
POST {{host}}/api/kitchen/items/{{pizzaItemId}}/ready
Authorization: Bearer {{kitchenToken}}

> {%
    client.test("pizza pronta de novo", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.status === "READY", "READY");
    });
%}


### 21. A pizza pronta continua na fila ate a entrega
GET {{host}}/api/kitchen/queue?station=PIZZA
Authorization: Bearer {{kitchenToken}}

> {%
    function hasItem(queue, id) { return queue.items.some(function(ticket) { return ticket.itemId === id; }); }
    client.test("pronta na fila", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(hasItem(response.body, client.global.get("pizzaItemId")), "pizza READY na fila");
    });
%}


### 22. Garcom entrega a pizza
POST {{host}}/api/restaurant/tabs/{{tableTabId}}/items/{{pizzaItemId}}/deliver
Authorization: Bearer {{waiterToken}}

> {%
    client.test("pizza entregue", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        var pizza = response.body.items.filter(function(item) { return item.id === client.global.get("pizzaItemId"); })[0];
        client.assert(pizza.status === "DELIVERED" && pizza.deliveredAt, "DELIVERED com deliveredAt");
    });
%}


### 23. A pizza entregue saiu da fila
GET {{host}}/api/kitchen/queue?station=PIZZA
Authorization: Bearer {{kitchenToken}}

> {%
    function hasItem(queue, id) { return queue.items.some(function(ticket) { return ticket.itemId === id; }); }
    client.test("fora da fila", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(!hasItem(response.body, client.global.get("pizzaItemId")), "pizza fora da fila");
    });
%}


### 24. Bar marca o refrigerante pronto direto, sem preparo
POST {{host}}/api/kitchen/items/{{sodaItemId}}/ready
