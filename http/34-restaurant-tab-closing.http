### ------------------------------------------------------------------
### Caminho feliz: lancamentos, taxa, divisao, pre-conta, pagamentos
### ------------------------------------------------------------------


### 9. Abre a comanda na mesa
POST {{host}}/api/restaurant/tabs
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "origin": "TABLE_SERVICE",
  "diningTableId": "{{diningTableId}}"
}

> {%
    client.test("comanda aberta com taxa ligada e total ao vivo", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.serviceChargeApplied === true, "taxa deveria nascer ligada na mesa");
        client.assert(response.body.total === "0.00", "total ao vivo de comanda vazia " + response.body.total);
        client.assert(response.body.serviceChargeRate === "10.00", "taxa ao vivo " + response.body.serviceChargeRate);
    });
    client.global.set("tabId", response.body.id);
%}


### 10. Lanca a pizza
POST {{host}}/api/restaurant/tabs/{{tabId}}/items
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "menuItemId": "{{pizzaId}}"
}

> {%
    client.test("pizza lancada no grupo 1", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        const item = response.body.items[response.body.items.length - 1];
        client.assert(item.splitGroup === 1, "item deveria nascer no grupo 1");
        client.assert(item.serviceChargeWaived === false, "item nasce com a taxa");
        client.global.set("pizzaItemId", item.id);
    });
%}


