### 35. Segundo fechamento: 74,00 + 5,00 = 79,00, com 30,00 ja pagos
POST {{host}}/api/restaurant/tabs/{{tabId}}/closing
Authorization: Bearer {{waiterToken}}

> {%
    client.test("saldo = novo total - pago", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.total === "79.00", "total " + response.body.total);
        client.assert(response.body.paid === "30.00", "pago " + response.body.paid);
        client.assert(response.body.balance === "49.00", "saldo " + response.body.balance);
    });
%}


