### 33. Reabre: o cliente pediu sobremesa depois de pagar 30,00
POST {{host}}/api/restaurant/tabs/{{tabId}}/reopen
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "reason": "cliente pediu sobremesa"
}

> {%
    client.test("reaberta: OPEN, total ao vivo, folio mantido", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.status === "OPEN", "status " + response.body.status);
        client.assert(response.body.total === "68.00", "total ao vivo depois de reabrir " + response.body.total);
        client.assert(response.body.folioId === client.global.get("folioId"), "o folio deveria ser o mesmo");
    });
%}


### 34. Lanca o pudim
POST {{host}}/api/restaurant/tabs/{{tabId}}/items
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "menuItemId": "{{puddingId}}"
}

> {%
