### 2a. Procura um turno de caixa esquecido aberto (200 ou 404)
GET {{host}}/api/billing/cash-sessions/current
Authorization: Bearer {{adminToken}}

> {%
    client.test("turno atual: 200 ou 404", function() {
        client.assert(response.status === 200 || response.status === 404, "esperado 200 ou 404, recebido " + response.status);
    });
    client.global.set("staleSessionId",
        response.status === 200 ? response.body.id : "00000000-0000-7000-8000-000000000000");
%}


### 2b. Fecha o turno esquecido, se houver (200 ou 404)
POST {{host}}/api/billing/cash-sessions/{{staleSessionId}}/close
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "countedAmount": "0.00",
  "note": "Fechado pela bancada .http"
}

> {%
    client.test("turno esquecido fechado, ou nenhum", function() {
        client.assert(response.status === 200 || response.status === 404, "esperado 200 ou 404, recebido " + response.status);
    });
%}


### 2c. Abre o turno de caixa com fundo de 50,00 (o dinheiro da comanda entra nele)
POST {{host}}/api/billing/cash-sessions
