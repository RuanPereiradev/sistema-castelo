### 13. Pre-conta em OPEN: taxa de 10% sobre 52,00
GET {{host}}/api/restaurant/tabs/{{tabId}}/bill
Authorization: Bearer {{waiterToken}}

> {%
    client.test("pre-conta: 64,00 + 5,20 = 69,20, sem folio", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.subtotal === "64.00", "subtotal " + response.body.subtotal);
        client.assert(response.body.serviceChargeBase === "52.00", "base " + response.body.serviceChargeBase);
        client.assert(response.body.serviceChargeRate === "10.00", "taxa " + response.body.serviceChargeRate);
        client.assert(response.body.serviceCharge === "5.20", "taxa de servico " + response.body.serviceCharge);
        client.assert(response.body.total === "69.20", "total " + response.body.total);
        client.assert(response.body.paid === null && response.body.balance === null, "sem folio, sem pago nem saldo");
    });
%}


### 14. Tira a taxa dos refrigerantes
PUT {{host}}/api/restaurant/tabs/{{tabId}}/items/{{sodaItemId}}/service-charge
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "applied": false
}

> {%
    client.test("sem a taxa do refrigerante: 64,00 + 4,00 = 68,00", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.serviceChargeBase === "40.00", "base " + response.body.serviceChargeBase);
        client.assert(response.body.serviceCharge === "4.00", "taxa " + response.body.serviceCharge);
        client.assert(response.body.total === "68.00", "total " + response.body.total);
    });
%}


### 15. Tres pessoas: divisao igual padrao
PUT {{host}}/api/restaurant/tabs/{{tabId}}/guest-count
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "guestCount": 3
}

> {%
    client.test("68,00 em 3: as primeiras cotas levam o centavo", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.guestCount === 3, "guestCount " + response.body.guestCount);
        client.assert(response.body.evenSplitParts === 3, "partes " + response.body.evenSplitParts);
        client.assert(JSON.stringify(response.body.evenSplit) === JSON.stringify(["22.67", "22.67", "22.66"]),
            "cotas " + JSON.stringify(response.body.evenSplit));
    });
%}


### 16. Divisao por item: pizza no grupo 1, refrigerante e couvert no grupo 2
PUT {{host}}/api/restaurant/tabs/{{tabId}}/split-groups
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "assignments": [
    {"itemId": "{{pizzaItemId}}", "splitGroup": 1},
    {"itemId": "{{sodaItemId}}", "splitGroup": 2},
    {"itemId": "{{couvertItemId}}", "splitGroup": 2}
  ]
}

> {%
    client.test("grupos: 44,00 (com taxa) e 24,00 (sem taxa), somando 68,00", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        const groups = response.body.groups;
        client.assert(groups.length === 2, "dois grupos, recebido " + groups.length);
        client.assert(groups[0].splitGroup === 1 && groups[0].total === "44.00" && groups[0].serviceCharge === "4.00",
            "grupo 1 " + JSON.stringify(groups[0]));
        client.assert(groups[1].splitGroup === 2 && groups[1].total === "24.00" && groups[1].serviceCharge === "0.00",
            "grupo 2 " + JSON.stringify(groups[1]));
        client.assert(response.body.total === "68.00", "o total nao muda");
    });
%}


### 17. Grupo 2 dividido em 2
GET {{host}}/api/restaurant/tabs/{{tabId}}/bill?parts=2&splitGroup=2
Authorization: Bearer {{waiterToken}}

> {%
    client.test("24,00 em 2", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(JSON.stringify(response.body.evenSplit) === JSON.stringify(["12.00", "12.00"]),
            "cotas " + JSON.stringify(response.body.evenSplit));
        client.assert(response.body.evenSplitGroup === 2, "grupo " + response.body.evenSplitGroup);
    });
%}


### 18. Inicia o fechamento (pre-conta): lanca 68,00 no folio
POST {{host}}/api/restaurant/tabs/{{tabId}}/closing
Authorization: Bearer {{waiterToken}}

> {%
    client.test("CLOSING com saldo 68,00 e nada pago", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.status === "CLOSING", "status " + response.body.status);
        client.assert(response.body.total === "68.00", "total " + response.body.total);
        client.assert(response.body.paid === "0.00", "pago " + response.body.paid);
        client.assert(response.body.balance === "68.00", "saldo " + response.body.balance);
        client.assert(JSON.stringify(response.body.balanceEvenSplit) === JSON.stringify(["22.67", "22.67", "22.66"]),
            "saldo em 3 " + JSON.stringify(response.body.balanceEvenSplit));
    });
%}


### 19. Le a comanda: total e percentual congelados, folio ligado
GET {{host}}/api/restaurant/tabs/{{tabId}}
Authorization: Bearer {{waiterToken}}

> {%
    client.test("comanda em CLOSING com o congelado", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.status === "CLOSING", "status " + response.body.status);
        client.assert(response.body.serviceChargeRate === "10.00", "taxa " + response.body.serviceChargeRate);
        client.assert(response.body.total === "68.00", "total " + response.body.total);
        client.assert(response.body.folioId !== null, "folio deveria estar ligado");
        client.assert(response.body.closingStartedAt !== null, "closingStartedAt");
    });
    client.global.set("folioId", response.body.folioId);
%}


### 20. Paga 30,00 em PIX
POST {{host}}/api/restaurant/tabs/{{tabId}}/payments
Authorization: Bearer {{waiterToken}}
Idempotency-Key: {{keyPrefix}}-pix
Content-Type: application/json

{
  "method": "PIX",
  "amount": "30.00"
}

> {%
    client.test("PIX registrado, saldo 38,00", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.method === "PIX", "metodo " + response.body.method);
        client.assert(response.body.amount === "30.00", "valor " + response.body.amount);
        client.assert(response.body.bill.balance === "38.00", "saldo " + response.body.bill.balance);
    });
    client.global.set("pixPaymentId", response.body.paymentId);
%}


### 21. Retry do mesmo PIX: devolve o original, nao registra de novo
POST {{host}}/api/restaurant/tabs/{{tabId}}/payments
Authorization: Bearer {{waiterToken}}
Idempotency-Key: {{keyPrefix}}-pix
Content-Type: application/json

{
  "method": "PIX",
  "amount": "30.00"
}

> {%
    client.test("replay: mesmo pagamento, saldo ainda 38,00", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.paymentId === client.global.get("pixPaymentId"), "deveria ser o mesmo pagamento");
        client.assert(response.body.bill.balance === "38.00", "saldo " + response.body.bill.balance);
    });
%}


