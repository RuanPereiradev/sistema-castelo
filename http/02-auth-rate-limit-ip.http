### B101. Username real ainda nao usado (garcom), senha CORRETA -> 429: o IP inteiro esta bloqueado
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "{{waiterUsername}}", "password": "{{password}}" }

> {%
    client.test("username real ainda nao usado recebe 429 com o IP bloqueado", function() {
        client.assert(response.status === 429, "esperado 429, recebido " + response.status);
        client.assert(response.body.code === "TOO_MANY_LOGIN_ATTEMPTS", "code deveria ser TOO_MANY_LOGIN_ATTEMPTS");
        client.assert(response.contentType.mimeType === "application/problem+json", "content-type deveria ser application/problem+json");
        client.assert(response.body.accessToken === undefined, "nenhum token pode ser emitido com o IP bloqueado");
    });
%}


### B102. Username inexistente ainda nao usado -> 429, e nao 401: o IP inteiro esta bloqueado
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "spray.nunca.usado", "password": "senha-errada-rate-limit" }

> {%
    client.test("username inexistente ainda nao usado recebe 429 com o IP bloqueado", function() {
        client.assert(response.status === 429, "esperado 429, recebido " + response.status);
        client.assert(response.body.code === "TOO_MANY_LOGIN_ATTEMPTS", "code deveria ser TOO_MANY_LOGIN_ATTEMPTS");
    });
%}
