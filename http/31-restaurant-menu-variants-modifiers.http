### 6. Troca o preco da G
PATCH {{host}}/api/restaurant/menu-items/{{pizzaId}}/variants/{{largeVariantId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "price": "72.00"
}

> {%
    client.test("preco da G alterado, nome mantido", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.variants[2].price === "72.00", "preco da G deveria ser 72.00");
        client.assert(response.body.variants[2].name === "G", "nome da G nao deveria mudar");
    });
%}


