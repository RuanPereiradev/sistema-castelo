### Task 1.2 - cardapio completo: variacoes (P/M/G) e adicionais
### Ambiente: selecione "dev" no IntelliJ HTTP Client, com http-client.env.json
### + http-client.private.env.json (copie o .example). Ver http/README.md.
###
### Pre-requisito: aplicacao rodando no perfil "dev" com o seed habilitado.
### Rode o arquivo inteiro, em ordem: os cenarios do caminho feliz salvam os ids
### que os cenarios negativos usam.
###
### Nomes levam um sufixo aleatorio porque nome de categoria, de item e de
### adicional e unico por propriedade: sem isso, a segunda execucao bateria em 409.


### 0. Login do admin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "{{adminUsername}}",
  "password": "{{password}}"
}

> {%
    client.test("login do admin retorna 200", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
    });
    client.global.set("accessToken", response.body.accessToken);
    client.global.set("suffix", Math.random().toString(36).substring(2, 8));
%}


### 1. Cria a categoria
POST {{host}}/api/restaurant/menu-categories
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Pizzas e grelhados {{suffix}}",
  "displayOrder": 1
}

> {%
    client.test("categoria criada retorna 201", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
    });
    client.global.set("categoryId", response.body.id);
%}


### 2. Cria a pizza, com preco proprio de referencia
POST {{host}}/api/restaurant/menu-items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "categoryId": "{{categoryId}}",
  "name": "Pizza Calabresa {{suffix}}",
  "prepStation": "PIZZA",
  "soldByWeight": false,
  "price": "50.00"
}

> {%
    client.test("pizza criada retorna 201 sem variacoes nem adicionais", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.variants.length === 0, "item nasce sem variacao");
        client.assert(response.body.modifiers.length === 0, "item nasce sem adicional");
    });
    client.global.set("pizzaId", response.body.id);
%}


### 3. Variacao P
POST {{host}}/api/restaurant/menu-items/{{pizzaId}}/variants
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "P",
  "price": "45.00"
}

> {%
    client.test("variacao P criada retorna 201, ativa e disponivel", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.variants.length === 1, "item deveria ter uma variacao");
        client.assert(response.body.variants[0].price === "45.00", "preco da P deveria ser 45.00");
        client.assert(response.body.variants[0].isActive === true, "variacao nasce ativa");
        client.assert(response.body.variants[0].isAvailable === true, "variacao nasce disponivel");
    });
    client.global.set("smallVariantId", response.body.variants[0].id);
%}


