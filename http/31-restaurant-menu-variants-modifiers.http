### 17. Variacao inexistente -> 404 MENU_ITEM_VARIANT_NOT_FOUND
PATCH {{host}}/api/restaurant/menu-items/{{pizzaId}}/variants/00000000-0000-0000-0000-0000000000ff
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "price": "10.00"
}

> {%
    client.test("variacao inexistente retorna 404", function() {
        client.assert(response.status === 404, "esperado 404, recebido " + response.status);
        client.assert(response.body.code === "MENU_ITEM_VARIANT_NOT_FOUND", "code deveria ser MENU_ITEM_VARIANT_NOT_FOUND");
    });
%}


