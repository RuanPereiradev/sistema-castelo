### 13. Acabou a G: esgota so ela
POST {{host}}/api/restaurant/menu-items/{{pizzaId}}/variants/{{largeVariantId}}/unavailable
Authorization: Bearer {{accessToken}}

> {%
    client.test("G esgotada, continua ativa", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.variants[2].isAvailable === false, "G deveria estar esgotada");
        client.assert(response.body.variants[2].isActive === true, "esgotar nao desativa");
        client.assert(response.body.isAvailable === true, "o item continua disponivel");
    });
%}


### 14. Leitura publica do cardapio, SEM token
GET {{host}}/public/menu

> {%
    function findItem(name) {
        for (var c = 0; c < response.body.categories.length; c++) {
            var items = response.body.categories[c].items;
            for (var i = 0; i < items.length; i++) {
                if (items[i].name === name) return items[i];
            }
        }
        return null;
    }
    var suffix = client.global.get("suffix");
    var pizza = findItem("Pizza Calabresa " + suffix);
    var steak = findItem("Picanha na chapa " + suffix);

    client.test("cardapio publico responde 200 sem autenticacao", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
    });
    client.test("pizza aparece com o preco 'a partir de' da menor variacao", function() {
        client.assert(pizza !== null, "pizza deveria estar no cardapio");
        client.assert(pizza.price === "45.00", "preco da vitrine deveria ser o da P, 45.00");
        client.assert(pizza.availableNow === true, "pizza continua disponivel com P e M");
        client.assert(pizza.variants.length === 3, "tres variacoes ativas");
    });
    client.test("G esgotada aparece indisponivel, P disponivel", function() {
        client.assert(pizza.variants[2].name === "G", "G e a terceira");
        client.assert(pizza.variants[2].availableNow === false, "G deveria estar indisponivel");
        client.assert(pizza.variants[0].availableNow === true, "P deveria estar disponivel");
    });
    client.test("adicionais com preco em string decimal, zero sai 0.00", function() {
        client.assert(pizza.modifiers[0].price === "12.00", "borda deveria custar 12.00");
        client.assert(pizza.modifiers[0].maxQuantity === 2, "borda ate 2");
        client.assert(steak.modifiers[0].price === "0.00", "ponto da carne deveria sair 0.00");
        client.assert(steak.price === "89.00", "sem variacao, vale o preco do item");
    });
%}


