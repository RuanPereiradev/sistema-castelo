### 3b. Username em formato invalido -> 401 INVALID_CREDENTIALS, resposta identica ao cenario 2
# "cozİnha" (I maiusculo com ponto, U+0130) nao e [a-z0-9._] nem depois de minusculas: e tratado
# como usuario inexistente, sem consulta ao banco e com o BCrypt descartavel. Nunca autentica como
# "cozinha", nem ganha 10 tentativas extras contra ela. A senha abaixo e a CORRETA do seed.
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "cozİnha",
  "password": "{{password}}"
}

> {%
    client.test("username em formato invalido retorna 401 identico a usuario inexistente", function() {
        client.assert(response.status === 401, "esperado 401, recebido " + response.status);
        client.assert(response.body.code === "INVALID_CREDENTIALS", "code deveria ser INVALID_CREDENTIALS");
        client.assert(response.body.detail === client.global.get("wrongPasswordDetail"), "detail deveria ser identico ao da senha errada");
        client.assert(response.body.accessToken === undefined, "nunca pode emitir token");
    });
%}


