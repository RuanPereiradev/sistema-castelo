### 16a. Login novo, os tokens anteriores foram invalidados nos cenarios 14 e 15
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "{{adminUsername}}",
  "password": "{{password}}"
}

> {%
    client.global.set("finalAccessToken", response.body.accessToken);
%}

### 16. GET /api/auth/me autenticado -> 200 com papeis, sem hash de senha
GET {{host}}/api/auth/me
Authorization: Bearer {{finalAccessToken}}

> {%
    client.test("me retorna papeis e nunca o hash de senha", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(Array.isArray(response.body.roles), "roles deveria ser uma lista");
        client.assert(response.body.roles.length === 1 && response.body.roles[0] === "ADMIN", "admin do seed tem apenas o papel ADMIN");
        client.assert(response.body.passwordHash === undefined, "passwordHash nunca deve aparecer na resposta");
    });
%}


### 17. JSON malformado no login -> 400 MALFORMED_REQUEST (erro nao vira 401)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "admin", "password":

> {%
    client.test("JSON malformado retorna 400 MALFORMED_REQUEST", function() {
        client.assert(response.status === 400, "esperado 400, recebido " + response.status);
        client.assert(response.body.code === "MALFORMED_REQUEST", "code deveria ser MALFORMED_REQUEST");
        client.assert(response.contentType.mimeType === "application/problem+json", "content-type deveria ser application/problem+json");
    });
%}


### 17b. Senha sem aspas no JSON -> 400 MALFORMED_REQUEST, sem ecoar o valor
# O valor invalido nunca pode voltar na resposta (nem aparecer no log da aplicacao).
POST {{host}}/api/auth/login
Content-Type: application/json

{"username":"admin","password":Canary123}

> {%
    client.test("senha sem aspas retorna 400 MALFORMED_REQUEST sem ecoar a senha", function() {
        client.assert(response.status === 400, "esperado 400, recebido " + response.status);
        client.assert(response.body.code === "MALFORMED_REQUEST", "code deveria ser MALFORMED_REQUEST");
        client.assert(JSON.stringify(response.body).indexOf("Canary123") === -1, "a senha nunca deve aparecer na resposta");
    });
%}


### 18. Rota inexistente com token valido -> 404 (erro nao vira 401)
GET {{host}}/api/rota-que-nao-existe
Authorization: Bearer {{finalAccessToken}}

> {%
    client.test("rota inexistente com token valido retorna 404", function() {
        client.assert(response.status === 404, "esperado 404, recebido " + response.status);
    });
%}
