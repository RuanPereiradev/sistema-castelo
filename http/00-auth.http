### 11. Token assinado com outro segredo -> 401 INVALID_TOKEN
# Token pre-gerado com outro segredo e exp em 2100: falha pela assinatura, nao pela expiracao.
GET {{host}}/api/auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJmY2NiYjJhNS05MTU2LTRmOGQtOTBkNC1iZjEzOGIwZjA1MTgiLCJ0b2tlblZlcnNpb24iOjAsInR5cGUiOiJhY2Nlc3MiLCJyb2xlcyI6WyJBRE1JTiJdLCJpYXQiOjE3ODkyNjI4NDgsImV4cCI6NDEwMjQ0NDgwMH0.wUXfPx7BgAypm5cNh54O3APigr9asychB737-xk-DTg

> {%
    client.test("token assinado com outro segredo retorna 401 INVALID_TOKEN", function() {
        client.assert(response.status === 401, "esperado 401, recebido " + response.status);
        client.assert(response.body.code === "INVALID_TOKEN", "code deveria ser INVALID_TOKEN");
    });
%}


### 12. Refresh valido -> 200 + novo access token
POST {{host}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    client.test("refresh valido retorna 200 com novo access token", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.accessToken !== undefined, "accessToken ausente");
        client.assert(response.body.expiresIn === 900, "expiresIn deveria ser 900 (15 min)");
    });
%}


### 12b. Refresh com access token expirado no header Authorization -> 200
# O filtro JWT nao roda em /api/auth/login nem /api/auth/refresh: um token velho
# esquecido no header pelo cliente nao pode impedir a renovacao.
POST {{host}}/api/auth/refresh
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJmY2NiYjJhNS05MTU2LTRmOGQtOTBkNC1iZjEzOGIwZjA1MTgiLCJ0b2tlblZlcnNpb24iOjAsInR5cGUiOiJhY2Nlc3MiLCJyb2xlcyI6WyJBRE1JTiJdLCJpYXQiOjE3ODkyNTkyNDYsImV4cCI6MTc4OTI2MDE0Nn0.kuQw4GCwX3rxwEY2xZJZyHH6SIZFitjwXJJ2w_Libmw

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    client.test("refresh ignora access token expirado no header", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.accessToken !== undefined, "accessToken ausente");
    });
%}


