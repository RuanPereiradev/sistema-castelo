        client.assert(response.body.code === "INVALID_CREDENTIALS", "code deveria ser INVALID_CREDENTIALS");
        client.assert(response.body.detail === client.global.get("wrongPasswordDetail"), "detail deveria ser identico ao da senha errada");
    });
%}


