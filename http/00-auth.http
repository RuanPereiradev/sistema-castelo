    client.global.set("waiterAccessToken", response.body.accessToken);
%}

### 8. Rota de ADMIN com token de WAITER -> 403 ACCESS_DENIED
GET {{host}}/api/admin/users
Authorization: Bearer {{waiterAccessToken}}

> {%
    client.test("rota de ADMIN com token de WAITER retorna 403", function() {
        client.assert(response.status === 403, "esperado 403, recebido " + response.status);
        client.assert(response.body.code === "ACCESS_DENIED", "code deveria ser ACCESS_DENIED");
        client.assert(response.contentType.mimeType === "application/problem+json", "content-type deveria ser application/problem+json");
    });
%}

### 8b. Rota de ADMIN com token de ADMIN -> 200, lista sem hash de senha
GET {{host}}/api/admin/users
Authorization: Bearer {{accessToken}}

> {%
    client.test("rota de ADMIN com token de ADMIN retorna 200", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(Array.isArray(response.body), "corpo deveria ser uma lista");
        var inactive = response.body.find(function(user) { return user.username === "inativo"; });
        client.assert(inactive !== undefined && inactive.isActive === false, "inativo deveria aparecer com isActive=false");
        response.body.forEach(function(user) {
            client.assert(user.passwordHash === undefined, "passwordHash nunca deve aparecer na resposta");
        });
    });
%}


### 9. Token expirado -> 401 TOKEN_EXPIRED
# Token pre-gerado (HS256, segredo dev-only-insecure-secret-please-change-me-1234567890,
# claim type "access"), ja expirado. So vale enquanto o segredo do perfil dev nao mudar.
GET {{host}}/api/auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJmY2NiYjJhNS05MTU2LTRmOGQtOTBkNC1iZjEzOGIwZjA1MTgiLCJ0b2tlblZlcnNpb24iOjAsInR5cGUiOiJhY2Nlc3MiLCJyb2xlcyI6WyJBRE1JTiJdLCJpYXQiOjE3ODkyNTkyNDYsImV4cCI6MTc4OTI2MDE0Nn0.kuQw4GCwX3rxwEY2xZJZyHH6SIZFitjwXJJ2w_Libmw

> {%
    client.test("token expirado retorna 401 TOKEN_EXPIRED", function() {
        client.assert(response.status === 401, "esperado 401, recebido " + response.status);
        client.assert(response.body.code === "TOKEN_EXPIRED", "code deveria ser TOKEN_EXPIRED");
        client.assert(response.contentType.mimeType === "application/problem+json", "content-type deveria ser application/problem+json");
    });
%}


