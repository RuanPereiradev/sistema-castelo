### 5. Username com maiusculas -> 200, mesmo usuario
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "ADMIN",
  "password": "{{password}}"
}

> {%
    client.test("username em maiusculas ainda autentica", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.user.username === "admin", "username normalizado deveria ser admin");
    });
    client.global.set("accessToken", response.body.accessToken);
    client.global.set("refreshToken", response.body.refreshToken);
%}


### 6. Rota protegida sem token -> 401 AUTHENTICATION_REQUIRED
GET {{host}}/api/auth/me

> {%
    client.test("rota protegida sem token retorna 401", function() {
        client.assert(response.status === 401, "esperado 401, recebido " + response.status);
        client.assert(response.body.code === "AUTHENTICATION_REQUIRED", "code deveria ser AUTHENTICATION_REQUIRED");
        client.assert(response.contentType.mimeType === "application/problem+json", "content-type deveria ser application/problem+json");
    });
%}


### 7. Rota protegida com token valido -> 200, sem hash de senha
GET {{host}}/api/auth/me
Authorization: Bearer {{accessToken}}

> {%
    client.test("rota protegida com token valido retorna 200", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.username === "admin", "username deveria ser admin");
        client.assert(response.body.passwordHash === undefined, "passwordHash nunca deve aparecer na resposta");
    });
%}


### 8a. Login do garcom (WAITER), para o cenario 8
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "{{waiterUsername}}",
  "password": "{{password}}"
}

> {%
    client.test("login do garcom retorna 200", function() {
