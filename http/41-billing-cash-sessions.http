### ------------------------------------------------------------------
### Fechamento
### ------------------------------------------------------------------


### 26. Admin fecha contando 99.50, com justificativa: esperado 100.00, falta 0.50
POST {{host}}/api/billing/cash-sessions/{{sessionId}}/close
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "countedAmount": "99.50",
  "note": "Faltaram 50 centavos no troco"
}

> {%
    client.test("turno fechado com a quebra congelada", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.status === "CLOSED", "turno deveria estar fechado");
        client.assert(response.body.expectedAmount === "100.00", "esperado deveria ser 100.00, veio " + response.body.expectedAmount);
        client.assert(response.body.countedAmount === "99.50", "contagem deveria ser 99.50");
        client.assert(response.body.difference === "-0.50", "diferenca deveria ser -0.50, veio " + response.body.difference);
        client.assert(response.body.closedAt !== null, "fechamento registra o instante");
    });
%}


### 27. Recepcao le o turno fechado: o esperado congelado aparece
GET {{host}}/api/billing/cash-sessions/{{sessionId}}
Authorization: Bearer {{frontDeskToken}}

> {%
    client.test("turno fechado mostra os valores congelados", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.expectedAmount === "100.00", "esperado congelado: 100.00");
        client.assert(response.body.cashPaymentsTotal === "150.00", "dinheiro contado: 150.00");
        client.assert(response.body.closingNote === "Faltaram 50 centavos no troco", "justificativa gravada");
    });
%}


