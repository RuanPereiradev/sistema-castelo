Content-Type: application/json
Idempotency-Key: {{cashKey2}}

{
  "amount": "200.00",
  "reason": "Deposito no cofre"
}

> {%
    client.test("repeticao nao registra outra sangria", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.totalDrops === "200.00", "sangrias continuam 200.00");
        client.assert(response.body.movements.length === 2, "continuam dois movimentos");
