### 7. Admin abre o turno com fundo de troco de 100.00
POST {{host}}/api/billing/cash-sessions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "openingFloat": "100.00"
}

> {%
    client.test("turno aberto com fundo de 100.00", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.status === "OPEN", "turno nasce aberto");
        client.assert(response.body.openingFloat === "100.00", "fundo deveria ser 100.00");
        client.assert(response.body.expectedAmount === "100.00", "o admin ve o esperado: 100.00");
        client.assert(response.body.difference === null, "sem diferenca enquanto aberto");
    });
    client.global.set("sessionId", response.body.id);
%}


### 8. Recepcao registra suprimento de 50.00
POST {{host}}/api/billing/cash-sessions/{{sessionId}}/supplies
Authorization: Bearer {{frontDeskToken}}
Content-Type: application/json
Idempotency-Key: {{cashKey1}}

{
  "amount": "50.00",
  "reason": "Troco para a noite"
}

> {%
    client.test("suprimento de 50.00 retorna 201", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.totalSupplies === "50.00", "suprimentos deveriam somar 50.00");
        client.assert(response.body.movements.length === 1, "um movimento");
        client.assert(response.body.movements[0].type === "CASH_SUPPLY", "movimento e suprimento");
    });
%}


### 9. Recepcao recebe 150.00 em dinheiro no folio: cai no turno aberto
POST {{host}}/api/billing/folios/{{cashFolioId}}/payments
Authorization: Bearer {{frontDeskToken}}
Content-Type: application/json
Idempotency-Key: {{paymentKey}}

{
  "method": "CASH",
  "amount": "150.00"
}

> {%
    client.test("pagamento em dinheiro de 150.00 quita o folio", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.balance === "0.00", "saldo deveria ser 0.00, veio " + response.body.balance);
    });
%}


### 10. Recepcao le o turno: fechamento cego, sem esperado nem total em dinheiro
GET {{host}}/api/billing/cash-sessions/{{sessionId}}
Authorization: Bearer {{frontDeskToken}}

> {%
    client.test("recepcao nao ve o esperado com o turno aberto", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.expectedAmount === null, "esperado oculto para a recepcao");
        client.assert(response.body.cashPaymentsTotal === null, "total em dinheiro oculto para a recepcao");
        client.assert(response.body.cashPaymentCount === 1, "um pagamento em dinheiro no turno");
    });
%}


### 11. Admin le o turno atual: 150.00 em dinheiro, esperado 300.00
GET {{host}}/api/billing/cash-sessions/current
Authorization: Bearer {{accessToken}}

> {%
    client.test("admin ve o esperado: 100 + 50 + 150", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.id === client.global.get("sessionId"), "deveria ser o turno aberto");
        client.assert(response.body.cashPaymentsTotal === "150.00", "dinheiro deveria somar 150.00, veio " + response.body.cashPaymentsTotal);
        client.assert(response.body.expectedAmount === "300.00", "esperado deveria ser 300.00, veio " + response.body.expectedAmount);
    });
%}


