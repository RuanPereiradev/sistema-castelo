Authorization: Bearer {{frontDeskToken}}
Content-Type: application/json

{
  "openingFloat": "50.00"
}

> {%
    client.test("segundo turno aberto recusado", function() {
        client.assert(response.status === 409, "esperado 409, recebido " + response.status);
        client.assert(response.body.code === "CASH_DRAWER_SESSION_ALREADY_OPEN", "code: " + response.body.code);
    });
%}


