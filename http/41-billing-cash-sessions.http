### 22. Justificativa com 501 caracteres -> 422 INVALID_CASH_CLOSING_NOTE
### A justificativa e opcional, com diferenca ou sem (decisao #22); so o limite de 500 vale.
POST {{host}}/api/billing/cash-sessions/{{sessionId}}/close
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "countedAmount": "99.50",
  "note": ""
}

> {%
    client.test("justificativa acima de 500 caracteres recusada", function() {
        client.assert(response.status === 422, "esperado 422, recebido " + response.status);
        client.assert(response.body.code === "INVALID_CASH_CLOSING_NOTE", "code: " + response.body.code);
    });
%}


