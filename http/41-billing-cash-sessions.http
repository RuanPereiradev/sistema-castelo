### 3. Procura um turno esquecido aberto (200 ou 404)
GET {{host}}/api/billing/cash-sessions/current
Authorization: Bearer {{accessToken}}

> {%
    client.test("turno atual: 200 ou 404", function() {
        client.assert(response.status === 200 || response.status === 404, "esperado 200 ou 404, recebido " + response.status);
    });
    client.global.set("staleSessionId",
        response.status === 200 ? response.body.id : "00000000-0000-7000-8000-000000000000");
%}


### 4. Admin fecha o turno esquecido, se houver (200 ou 404)
POST {{host}}/api/billing/cash-sessions/{{staleSessionId}}/close
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "countedAmount": "0.00",
  "note": "Fechado pela bancada .http"
}

> {%
    client.test("turno esquecido fechado, ou nenhum", function() {
        client.assert(response.status === 200 || response.status === 404, "esperado 200 ou 404, recebido " + response.status);
    });
%}


### 5. [dev] Abre um folio TAB
POST {{host}}/api/billing/dev/folios
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "TAB"
}

> {%
    client.test("folio TAB aberto", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
    });
    client.global.set("cashFolioId", response.body.id);
%}


### 6. [dev] Lanca o consumo de 150.00
POST {{host}}/api/billing/dev/folios/{{cashFolioId}}/charges
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "sourceType": "TAB",
  "amount": "150.00",
  "description": "Restaurante - comanda 77"
}

> {%
    client.test("lancamento de 150.00", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.balance === "150.00", "saldo deveria ser 150.00, veio " + response.body.balance);
    });
%}


