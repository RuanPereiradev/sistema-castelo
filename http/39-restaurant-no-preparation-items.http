### 3. Cria a categoria
POST {{host}}/api/restaurant/menu-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Sem preparo {{suffix}}",
  "displayOrder": 1
}

> {%
    client.test("categoria criada", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
    });
    client.global.set("categoryId", response.body.id);
%}


### ------------------------------------------------------------------
### Caminho feliz
### ------------------------------------------------------------------


### 4. Refrigerante sem preparo, setor BAR (o setor continua obrigatorio, decisao #3)
POST {{host}}/api/restaurant/menu-items
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "categoryId": "{{categoryId}}",
  "name": "Refrigerante lata {{suffix}}",
  "prepStation": "BAR",
  "soldByWeight": false,
  "price": "6.00",
  "requiresPreparation": false
}

> {%
    client.test("refrigerante criado sem preparo", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.requiresPreparation === false, "requiresPreparation false");
        client.assert(response.body.prepStation === "BAR", "setor BAR mantido");
    });
    client.global.set("sodaId", response.body.id);
%}


### 5. Caipirinha sem o campo: precisa de preparo (ausente = true, decisao #6)
POST {{host}}/api/restaurant/menu-items
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "categoryId": "{{categoryId}}",
  "name": "Caipirinha {{suffix}}",
  "prepStation": "BAR",
  "soldByWeight": false,
  "price": "18.00"
}

> {%
    client.test("caipirinha criada precisando de preparo", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.requiresPreparation === true, "requiresPreparation true por padrao");
    });
    client.global.set("caipirinhaId", response.body.id);
%}


