%}


### 22. Alterar sem token
PATCH {{host}}/api/restaurant/menu-items/{{sodaId}}/requires-preparation
Content-Type: application/json

{
  "requiresPreparation": true
}

> {%
    client.test("sem token", function() {
        client.assert(response.status === 401, "esperado 401, recebido " + response.status);
        client.assert(response.body.code === "AUTHENTICATION_REQUIRED", "code AUTHENTICATION_REQUIRED, recebido " + response.body.code);
    });
%}


### 23. Alterar sem o campo: recusado, nunca lido como false
PATCH {{host}}/api/restaurant/menu-items/{{sodaId}}/requires-preparation
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{}

> {%
    client.test("campo obrigatorio", function() {
        client.assert(response.status === 400, "esperado 400, recebido " + response.status);
        client.assert(response.body.code === "VALIDATION_FAILED", "code VALIDATION_FAILED, recebido " + response.body.code);
    });
%}


### 24. Alterar item inexistente
PATCH {{host}}/api/restaurant/menu-items/0192f5a0-0000-7000-8000-000000000000/requires-preparation
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "requiresPreparation": false
}

> {%
    client.test("item nao encontrado", function() {
        client.assert(response.status === 404, "esperado 404, recebido " + response.status);
        client.assert(response.body.code === "MENU_ITEM_NOT_FOUND", "code MENU_ITEM_NOT_FOUND, recebido " + response.body.code);
    });
%}


### 25. Cozinha nao marca pronto o que ja nasceu pronto
POST {{host}}/api/kitchen/items/{{cardSodaItemId}}/ready
Authorization: Bearer {{kitchenToken}}

> {%
    client.test("transicao recusada", function() {
        client.assert(response.status === 409, "esperado 409, recebido " + response.status);
        client.assert(response.body.code === "INVALID_TAB_ITEM_TRANSITION", "code INVALID_TAB_ITEM_TRANSITION, recebido " + response.body.code);
    });
%}


### 26. Entregar de novo o refrigerante ja entregue
POST {{host}}/api/restaurant/tabs/{{tableTabId}}/items/{{sodaItemId}}/deliver
Authorization: Bearer {{waiterToken}}

