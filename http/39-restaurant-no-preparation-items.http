### 19. Self-service: o refrigerante tambem nasce READY
POST {{host}}/api/restaurant/tabs/{{cardTabId}}/items
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "menuItemId": "{{sodaId}}"
}

> {%
    client.test("refrigerante no cartao nasce pronto", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.items[0].status === "READY", "status READY, recebido " + response.body.items[0].status);
    });
    client.global.set("cardSodaItemId", response.body.items[0].id);
%}


