### 9. Garcom lanca o refrigerante: nasce READY, com readyAt e sem inicio de preparo
POST {{host}}/api/restaurant/tabs/{{tableTabId}}/items
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "menuItemId": "{{sodaId}}",
  "quantity": 2
}

> {%
    client.test("refrigerante nasce pronto", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        var item = response.body.items[response.body.items.length - 1];
        client.assert(item.status === "READY", "status READY, recebido " + item.status);
        client.assert(item.readyAt, "readyAt gravado");
        client.assert(item.preparationStartedAt === null, "sem preparationStartedAt");
    });
    client.global.set("sodaItemId", response.body.items[response.body.items.length - 1].id);
%}


### 10. Garcom lanca a caipirinha: item normal continua PENDING
POST {{host}}/api/restaurant/tabs/{{tableTabId}}/items
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "menuItemId": "{{caipirinhaId}}"
}

> {%
    client.test("caipirinha nasce pendente", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        var item = response.body.items[response.body.items.length - 1];
        client.assert(item.status === "PENDING", "status PENDING, recebido " + item.status);
    });
    client.global.set("caipirinhaItemId", response.body.items[response.body.items.length - 1].id);
%}


### 11. Fila do bar: tem a caipirinha, nao tem o refrigerante
GET {{host}}/api/kitchen/queue?station=BAR
Authorization: Bearer {{kitchenToken}}

> {%
    function hasItem(queue, id) { return queue.items.some(function(ticket) { return ticket.itemId === id; }); }
    client.test("fila BAR sem o item sem preparo", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(hasItem(response.body, client.global.get("caipirinhaItemId")), "caipirinha na fila");
        client.assert(!hasItem(response.body, client.global.get("sodaItemId")), "refrigerante fora da fila");
    });
%}


### 12. Nenhum outro setor tem o refrigerante
GET {{host}}/api/kitchen/queue?station=KITCHEN
Authorization: Bearer {{kitchenToken}}

> {%
    function hasItem(queue, id) { return queue.items.some(function(ticket) { return ticket.itemId === id; }); }
    client.test("fila KITCHEN sem o refrigerante", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(!hasItem(response.body, client.global.get("sodaItemId")), "refrigerante fora da fila");
    });
%}


### 13. Garcom entrega o refrigerante
POST {{host}}/api/restaurant/tabs/{{tableTabId}}/items/{{sodaItemId}}/deliver
Authorization: Bearer {{waiterToken}}

> {%
    client.test("refrigerante entregue", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        var soda = response.body.items.filter(function(item) { return item.id === client.global.get("sodaItemId"); })[0];
        client.assert(soda.status === "DELIVERED" && soda.deliveredAt, "DELIVERED com deliveredAt");
    });
%}


### 14. Admin volta a exigir preparo do refrigerante
PATCH {{host}}/api/restaurant/menu-items/{{sodaId}}/requires-preparation
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "requiresPreparation": true
}

> {%
    client.test("marcacao alterada para true", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.requiresPreparation === true, "requiresPreparation true");
    });
%}


### 15. Lancado agora, o refrigerante vai para a fila do bar como PENDING
POST {{host}}/api/restaurant/tabs/{{tableTabId}}/items
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "menuItemId": "{{sodaId}}"
}

> {%
    client.test("refrigerante com preparo nasce pendente", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        var item = response.body.items[response.body.items.length - 1];
        client.assert(item.status === "PENDING", "status PENDING, recebido " + item.status);
    });
    client.global.set("preparedSodaItemId", response.body.items[response.body.items.length - 1].id);
%}


### 16. Admin tira o preparo de novo
PATCH {{host}}/api/restaurant/menu-items/{{sodaId}}/requires-preparation
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "requiresPreparation": false
}

> {%
    client.test("marcacao alterada para false", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.requiresPreparation === false, "requiresPreparation false");
    });
%}


### 17. O que ja foi lancado nao muda: o refrigerante do passo 15 continua na fila do bar
GET {{host}}/api/kitchen/queue?station=BAR
Authorization: Bearer {{kitchenToken}}

> {%
    function hasItem(queue, id) { return queue.items.some(function(ticket) { return ticket.itemId === id; }); }
    client.test("item ja lancado continua na fila", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(hasItem(response.body, client.global.get("preparedSodaItemId")), "refrigerante do passo 15 na fila");
    });
%}


