### 20. Garcom alterando a marcacao
PATCH {{host}}/api/restaurant/menu-items/{{sodaId}}/requires-preparation
Authorization: Bearer {{waiterToken}}
Content-Type: application/json

{
  "requiresPreparation": true
}

> {%
    client.test("garcom barrado", function() {
        client.assert(response.status === 403, "esperado 403, recebido " + response.status);
        client.assert(response.body.code === "ACCESS_DENIED", "code ACCESS_DENIED, recebido " + response.body.code);
    });
%}


### 21. Cozinha alterando a marcacao
PATCH {{host}}/api/restaurant/menu-items/{{sodaId}}/requires-preparation
Authorization: Bearer {{kitchenToken}}
Content-Type: application/json

{
  "requiresPreparation": true
}

> {%
    client.test("cozinha barrada", function() {
        client.assert(response.status === 403, "esperado 403, recebido " + response.status);
        client.assert(response.body.code === "ACCESS_DENIED", "code ACCESS_DENIED, recebido " + response.body.code);
