### 11. Recepcao estorna o consumo lancado no quarto errado
POST {{host}}/api/billing/folios/{{stayFolioId}}/charges/{{stayTabChargeId}}/reversal
Authorization: Bearer {{frontDeskToken}}
Content-Type: application/json

{
  "reason": "Lancado no quarto errado"
}

> {%
    const original = response.body.charges.find(function(charge) { return charge.id === client.global.get("stayTabChargeId"); });
    const reversal = response.body.charges.find(function(charge) { return charge.reversalOf === client.global.get("stayTabChargeId"); });
    client.test("estorno e um lancamento oposto; o original fica", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.balance === "300.00", "saldo deveria voltar a 300.00, veio " + response.body.balance);
        client.assert(original.amount === "45.00", "o original continua intacto");
        client.assert(original.reversedBy === reversal.id, "o original aponta o estorno");
        client.assert(reversal.amount === "-45.00", "o estorno tem o valor oposto");
        client.assert(reversal.reason === "Lancado no quarto errado", "o estorno guarda o motivo");
    });
    client.global.set("stayReversalId", reversal.id);
%}


### 12. Recebe 350.00 no cartao: folio STAY aceita e fica com credito
POST {{host}}/api/billing/folios/{{stayFolioId}}/payments
Authorization: Bearer {{frontDeskToken}}
Content-Type: application/json
Idempotency-Key: {{key3}}

{
  "method": "CREDIT_CARD",
  "amount": "350.00"
}

> {%
    client.test("pagamento acima do saldo em STAY deixa saldo negativo", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.balance === "-50.00", "saldo deveria ser -50.00, veio " + response.body.balance);
    });
    client.global.set("stayPaymentId", response.body.id);
%}


### 13. Admin estorna o pagamento de 350.00
POST {{host}}/api/billing/folios/{{stayFolioId}}/payments/{{stayPaymentId}}/refund
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "Cobrado no cartao errado"
}

> {%
    const payment = response.body.payments.find(function(item) { return item.id === client.global.get("stayPaymentId"); });
    client.test("pagamento estornado deixa de abater o saldo", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(payment.status === "REFUNDED", "pagamento deveria estar REFUNDED");
        client.assert(payment.refundReason === "Cobrado no cartao errado", "motivo do estorno guardado");
        client.assert(response.body.totalPayments === "0.00", "nenhum pagamento abate");
        client.assert(response.body.balance === "300.00", "saldo deveria ser 300.00, veio " + response.body.balance);
    });
%}


