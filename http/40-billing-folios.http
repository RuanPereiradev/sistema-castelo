### 38. Chave de outro folio -> 409 IDEMPOTENCY_KEY_REUSED
POST {{host}}/api/billing/folios/{{otherFolioId}}/payments
Authorization: Bearer {{frontDeskToken}}
Content-Type: application/json
Idempotency-Key: {{key1}}

{
  "method": "PIX",
  "amount": "50.00"
}

> {%
    client.test("chave de outro folio retorna 409", function() {
        client.assert(response.status === 409, "esperado 409, recebido " + response.status);
        client.assert(response.body.code === "IDEMPOTENCY_KEY_REUSED", "code deveria ser IDEMPOTENCY_KEY_REUSED");
