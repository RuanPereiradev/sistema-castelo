### 7. Fecha o folio TAB
POST {{host}}/api/billing/folios/{{tabFolioId}}/close
Authorization: Bearer {{frontDeskToken}}

> {%
    client.test("folio TAB fechado com saldo zero", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.status === "CLOSED", "folio deveria estar CLOSED");
        client.assert(response.body.closedAt !== null, "closedAt deveria estar preenchido");
        client.assert(response.body.payments.length === 2, "dois pagamentos, a repeticao nao conta");
    });
%}


