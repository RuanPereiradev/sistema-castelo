### Task 1.3 - folio: lancamentos, estorno e pagamentos
### Ambiente: selecione "dev" no IntelliJ HTTP Client, com http-client.env.json
### + http-client.private.env.json (copie o .example). Ver http/README.md.
###
### Pre-requisito: aplicacao rodando no perfil "dev" com o seed habilitado. Os folios
### sao abertos e recebem lancamentos pela rota so de dev (/api/billing/dev/folios,
### decisao #12): nenhuma rota real abre folio nesta task.
### Rode o arquivo inteiro, em ordem: os cenarios salvam os ids que os seguintes usam.
###
### Chaves de idempotencia e codigos de referencia levam um sufixo aleatorio por
### execucao: a chave e unica no sistema inteiro, e o codigo e unico entre os folios
### STAY abertos.


### 0. Login do admin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "{{adminUsername}}",
  "password": "{{password}}"
}

> {%
    client.test("login do admin retorna 200", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
    });
    client.global.set("accessToken", response.body.accessToken);
    const suffix = Math.random().toString(36).substring(2, 8);
    client.global.set("suffix", suffix);
    client.global.set("stayCode", "Q" + suffix);
    client.global.set("otherStayCode", "N" + suffix);
    client.global.set("key1", "k-" + suffix + "-1");
    client.global.set("key2", "k-" + suffix + "-2");
    client.global.set("key3", "k-" + suffix + "-3");
    client.global.set("key4", "k-" + suffix + "-4");
    client.global.set("key5", "k-" + suffix + "-5");
    client.global.set("key6", "k-" + suffix + "-6");
    client.global.set("key7", "k-" + suffix + "-7");
%}


### 1. Login da recepcao
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "{{frontDeskUsername}}",
  "password": "{{password}}"
}

> {%
    client.test("login da recepcao retorna 200", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
    });
    client.global.set("frontDeskToken", response.body.accessToken);
%}


### ------------------------------------------------------------------
### Caminho feliz: folio de comanda (TAB)
### ------------------------------------------------------------------


### 2. [dev] Abre um folio TAB
POST {{host}}/api/billing/dev/folios
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "TAB"
}

> {%
    client.test("folio TAB aberto, sem referencia, saldo zero", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.status === "OPEN", "folio nasce aberto");
        client.assert(response.body.referenceCode === null, "folio TAB nao tem referencia");
        client.assert(response.body.balance === "0.00", "saldo deveria ser 0.00");
    });
    client.global.set("tabFolioId", response.body.id);
%}


### 3. [dev] Lanca o consumo de 120.00
POST {{host}}/api/billing/dev/folios/{{tabFolioId}}/charges
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "sourceType": "TAB",
  "amount": "120.00",
  "description": "Restaurante - comanda 142"
}

> {%
    client.test("lancamento de 120.00", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.balance === "120.00", "saldo deveria ser 120.00, veio " + response.body.balance);
    });
%}


### 4. Recepcao recebe 50.00 em PIX
POST {{host}}/api/billing/folios/{{tabFolioId}}/payments
Authorization: Bearer {{frontDeskToken}}
Content-Type: application/json
Idempotency-Key: {{key1}}

{
  "method": "PIX",
  "amount": "50.00"
}

> {%
    client.test("pagamento de 50.00 retorna 201 e saldo 70.00", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.status === "CONFIRMED", "pagamento nasce CONFIRMED");
        client.assert(response.body.balance === "70.00", "saldo deveria ser 70.00, veio " + response.body.balance);
    });
    client.global.set("tabPaymentId", response.body.id);
%}


### 5. Repete o mesmo pagamento (duplo clique): mesmo id, sem pagar duas vezes
POST {{host}}/api/billing/folios/{{tabFolioId}}/payments
Authorization: Bearer {{frontDeskToken}}
Content-Type: application/json
Idempotency-Key: {{key1}}

{
  "method": "PIX",
  "amount": "50.00"
}

> {%
    client.test("repeticao devolve o mesmo pagamento", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.id === client.global.get("tabPaymentId"), "deveria ser o mesmo pagamento");
        client.assert(response.body.balance === "70.00", "saldo continua 70.00, veio " + response.body.balance);
    });
%}


