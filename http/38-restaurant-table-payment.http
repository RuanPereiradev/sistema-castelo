### 20. Garcom ve o pagamento aguardando, com o nome de quem paga
GET {{host}}/api/restaurant/table-payment-requests
Authorization: Bearer {{waiterToken}}

> {%
    client.test("pagamento na fila, com mesa, nome e item", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        const request = response.body.find(r => r.id === client.global.get("pizzaARequestId"));
        client.assert(request !== undefined, "pagamento nao esta na fila");
        client.assert(request.diningTableLabel === "Pix " + client.global.get("suffix"), "mesa " + request.diningTableLabel);
        client.assert(request.customerName === "Bruno", "nome " + request.customerName);
        client.assert(request.amount === "44.00", "valor " + request.amount);
        client.assert(request.items[0].itemName === "Pizza Pix " + client.global.get("suffix"), "item");
    });
%}


