### ------------------------------------------------------------------
### Caminho feliz: pagar a parte com a comanda OPEN
### ------------------------------------------------------------------


### 16. Celular da Ana le a comanda da mesa: os sucos sao dela
GET {{host}}/public/tables/{{orderingToken}}/tab
X-Customer-Device: device-{{suffix}}-ana

> {%
    client.test("comanda no celular: 3 linhas, nada pago, aceita Pix", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.items.length === 3, "itens " + response.body.items.length);
        client.assert(response.body.total === "117.70", "total " + response.body.total);
        client.assert(response.body.paidAmount === "0.00", "pago " + response.body.paidAmount);
        client.assert(response.body.amountDue === "117.70", "falta " + response.body.amountDue);
        client.assert(response.body.acceptsPayment === true, "deveria aceitar Pix");
        const juice = response.body.items.find(i => i.quantity === 3);
        client.assert(juice.customerName === "Ana" && juice.mine === true, "sucos da Ana");
        client.assert(juice.customerDeviceId === undefined, "nao expoe o aparelho");
        const pizza = response.body.items.find(i => i.quantity === 1);
        client.assert(pizza.mine === false && pizza.customerName === null, "pizza do garcom");
        client.assert(response.body.items[0].prepStation === undefined, "nao expoe setor");
    });
    client.global.set("juiceItemId", response.body.items.find(i => i.quantity === 3).id);
%}


### 16b. Sem o aparelho, nada e "meu"
GET {{host}}/public/tables/{{orderingToken}}/tab

> {%
    client.test("sem header, mine sempre falso", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.items.every(i => i.mine === false), "mine deveria ser falso");
    });
%}


### 17. Cliente paga a pizza A com a taxa: 40,00 + 4,00
POST {{host}}/public/tables/{{orderingToken}}/payment-requests
Content-Type: application/json

{
  "customerName": "Bruno",
  "customerDeviceId": "device-{{suffix}}-bruno",
  "includeServiceCharge": true,
  "items": [{"tabItemId": "{{pizzaAItemId}}", "quantity": 1}]
}

> {%
    client.test("Pix gerado com o valor: 44,00", function() {
        client.assert(response.status === 201, "esperado 201, recebido " + response.status);
        client.assert(response.body.status === "PENDING", "status " + response.body.status);
        client.assert(response.body.amount === "44.00", "valor " + response.body.amount);
        client.assert(response.body.serviceCharge === "4.00", "taxa " + response.body.serviceCharge);
        client.assert(response.body.pixPayload.startsWith("000201"), "payload " + response.body.pixPayload);
        client.assert(response.body.pixPayload.indexOf("540544.00") > 0, "valor no payload");
        client.assert(/6304[0-9A-F]{4}$/.test(response.body.pixPayload), "CRC no fim");
    });
    client.global.set("pizzaARequestId", response.body.id);
%}


