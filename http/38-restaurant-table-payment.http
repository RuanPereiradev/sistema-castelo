### 22. Celular ve a pizza A paga: pago 44,00, falta 73,70
GET {{host}}/public/tables/{{orderingToken}}/tab

> {%
    client.test("pizza A paga no celular", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        const pizzaA = response.body.items.find(i => i.id === client.global.get("pizzaAItemId"));
        client.assert(pizzaA.paid === true, "pizza A deveria estar paga");
        client.assert(response.body.paidAmount === "44.00", "pago " + response.body.paidAmount);
        client.assert(response.body.amountDue === "73.70", "falta " + response.body.amountDue);
    });
%}


### 23. Pre-conta: o folio ja recebeu os 44,00 da parte
GET {{host}}/api/restaurant/tabs/{{tabId}}/bill
Authorization: Bearer {{waiterToken}}

> {%
    client.test("pre-conta com o pago abatido", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.total === "117.70", "total " + response.body.total);
        client.assert(response.body.paidAmount === "44.00", "pago pelo celular " + response.body.paidAmount);
        client.assert(response.body.amountDue === "73.70", "falta " + response.body.amountDue);
        client.assert(response.body.paid === "44.00", "pago no folio " + response.body.paid);
        client.assert(response.body.balance === "0.00", "saldo " + response.body.balance);
    });
%}


