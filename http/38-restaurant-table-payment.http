### 34. Pre-conta: falta 44,00 (a pizza B com taxa); o suco sem taxa baixou o total
GET {{host}}/api/restaurant/tabs/{{tabId}}/bill
Authorization: Bearer {{waiterToken}}

> {%
    client.test("saldo 44,00, total 116,80", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.balance === "44.00", "saldo " + response.body.balance);
        client.assert(response.body.amountDue === "44.00", "falta " + response.body.amountDue);
        client.assert(response.body.paidAmount === "72.80", "pago pelo celular " + response.body.paidAmount);
        client.assert(response.body.total === "116.80", "total " + response.body.total);
        client.assert(response.body.unpaidServiceChargeBase === "40.00", "base nao paga " + response.body.unpaidServiceChargeBase);
        const groupsTotal = response.body.groups.reduce((sum, g) => sum + Number(g.total), 0).toFixed(2);
        client.assert(groupsTotal === "116.80", "grupos somam o total " + groupsTotal);
    });
%}


