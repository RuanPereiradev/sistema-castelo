### A11. 11a tentativa do admin, com a senha CORRETA -> 429 TOO_MANY_LOGIN_ATTEMPTS
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "{{adminUsername}}", "password": "{{password}}" }

> {%
    client.test("11a tentativa do par com senha correta retorna 429 TOO_MANY_LOGIN_ATTEMPTS", function() {
        client.assert(response.status === 429, "esperado 429, recebido " + response.status);
        client.assert(response.body.code === "TOO_MANY_LOGIN_ATTEMPTS", "code deveria ser TOO_MANY_LOGIN_ATTEMPTS");
        client.assert(response.contentType.mimeType === "application/problem+json", "content-type deveria ser application/problem+json");
        client.assert(response.body.accessToken === undefined, "nenhum token pode ser emitido com o par bloqueado");
    });
%}


### A12. Outro username do mesmo IP (recepcao), senha correta -> 200: so o par do admin esta bloqueado
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "{{frontDeskUsername}}", "password": "{{password}}" }

> {%
    client.test("outro username do mesmo IP continua logando", function() {
        client.assert(response.status === 200, "esperado 200, recebido " + response.status);
        client.assert(response.body.accessToken !== undefined, "accessToken ausente");
        client.assert(response.body.user.username === "recepcao", "username deveria ser recepcao");
    });
%}
