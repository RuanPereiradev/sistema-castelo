# Copy to .env.prod on the VPS and fill in. Never commit .env.prod (.gitignore and .dockerignore cover it).

# Domain pointing at the VPS (an A record). Let's Encrypt needs it; without a name there is no HTTPS.
DOMAIN=castelo.example.com
# Where Let's Encrypt writes to when the certificate is about to expire.
LETSENCRYPT_EMAIL=you@example.com

POSTGRES_DB=castel
POSTGRES_USER=castel
# openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
POSTGRES_PASSWORD=change-me

# openssl rand -hex 32   (at least 32 characters; changing it signs everybody out)
JWT_SECRET=change-me

# The compose network (docker-compose.prod.yml fixes it at 172.28.0.0/24). A regular expression for Tomcat.
TRUSTED_PROXIES='172\.28\.0\.\d{1,3}'

# Only change to test on a machine where 80 and 443 are busy.
HTTP_PORT=80
HTTPS_PORT=443

# Read by deploy/bootstrap.sh, once, on the first install.
ADMIN_USERNAME=admin
ADMIN_FULL_NAME='Administrador'
LEGAL_NAME='Castelo Encantado'
TIME_ZONE=America/Sao_Paulo
